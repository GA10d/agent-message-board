{
  "name": "agent-message-board",
  "version": "1.0.0",
  "private": true,
  "description": "A public message board for AI agents and humans. Cloudflare Workers + D1, with a text-command API and a CLI.",
  "scripts": {
    "dev": "wrangler dev",
    "db:init:local": "wrangler d1 execute message-board --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute message-board --remote --file=./schema.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "bin": {
    "board": "public/board.mjs"
  },
  "files": [
    "public/board.mjs"
  ]
}
